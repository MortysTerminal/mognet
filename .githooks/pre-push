#!/bin/bash
# pre-push: for every pushed commit check identity, attribution and private terms; then run gitleaks.
. "$(dirname "$0")/lib.sh"
ZERO=0000000000000000000000000000000000000000

deny_init || exit 1
trap 'rm -f "$DENY_TERMS"' EXIT
command -v gitleaks >/dev/null 2>&1 || { echo "BLOCKED: gitleaks not installed. Install: brew install gitleaks" >&2; exit 1; }

fail=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue   # branch deletion
  if [ "$rsha" = "$ZERO" ]; then
    range=("$lsha" --not "--remotes=$1")                       # new branch: everything not on this remote
  elif git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    range=("$lsha" --not "$rsha")
  else
    range=("$lsha" --not "--remotes=$1")
  fi
  for c in $(git rev-list "${range[@]}"); do
    short=$(git rev-parse --short "$c")
    for e in $(git log -1 --format='%ae %ce' "$c"); do
      [ "$e" = "$ALLOWED_EMAIL" ] || { echo "BLOCKED: commit $short has a non-allowed author/committer e-mail." >&2; fail=1; }
    done
    if git log -1 --format=%B "$c" | grep -qiE "$ATTR_RE"; then
      echo "BLOCKED: commit $short message contains AI attribution." >&2; fail=1
    fi
    git log -1 --format='%an%n%ae%n%cn%n%ce%n%B' "$c" | deny_scan "metadata of commit $short" || fail=1
    git show --format= -U0 "$c" | grep -E '^(\+|diff --git)' | deny_scan "changes of commit $short" || fail=1
  done
  gitleaks git --redact --no-banner --log-opts="${range[*]}" . || { echo "BLOCKED: gitleaks reported findings." >&2; fail=1; }
done
exit $fail
